{
  "name": "shiftmaster-pro---weekly-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "dev:emu": "vite --mode emulator --port 3100 --strictPort",
    "emu": "node scripts/emulators.mjs start",
    "emu:seed": "node scripts/seed-emulator.mjs",
    "test:functions": "node scripts/emulators.mjs exec \"node scripts/test-functions.mjs\"",
    "test:rules": "node scripts/emulators.mjs exec \"node scripts/test-rules.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
