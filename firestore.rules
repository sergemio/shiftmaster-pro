rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data model
    // ===============================================================
    //
    // weeks/{weekId}         weekId = ISO date of the SUNDAY before the week.
    //                        shifts: Shift[], updatedAt: ISO string.
    //                        dayIndex 0 = Monday .. 6 = Sunday.
    //
    // settings/staff         list: Staff[]         (full objects, for the app)
    //                        admins: string[]      (emails, flat — rules cannot
    //                        staffEmails: string[]  read inside arrays of objects,
    //                        guests: string[]       hence these flat mirrors)
    //
    // settings/global        timezone, language
    //
    // logs/{logId}           userId, userName, action, details, timestamp,
    //                        and on newer entries targetStaffId/Name, weekId.
    //                        NOTE: there is no `id` field — Firestore assigns
    //                        the document id, addDoc never writes one. A rule
    //                        requiring data.id would reject every single log.
    //
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/settings/staff).data;
    }

    function staffDocExists() {
      return exists(/databases/$(database)/documents/settings/staff);
    }

    function email() {
      return request.auth.token.email;
    }

    // Serge is hardcoded on purpose: it is the lock-out escape hatch. If the
    // roster document is ever emptied or corrupted again (as on 2026-05-04),
    // every other admin check evaluates false and nobody could repair it.
    // This works from anywhere in the world — it is the account that matters,
    // not the location.
    function isOwner() {
      return isSignedIn()
             && email() == "sergemenassa@gmail.com"
             && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isOwner()
             || (isSignedIn() && staffDocExists() && email() in staffDoc().admins);
    }

    // Anyone on the team, plus invited guests. Reading the planning is allowed;
    // only admins write. Previously this returned true for ANY signed-in Google
    // account, because its second clause was `list.size() > 0` — always true.
    function isTeamMember() {
      return isAdmin()
             || (isSignedIn() && staffDocExists()
                 && (email() in staffDoc().staffEmails || email() in staffDoc().guests));
    }

    function isValidShift(shift) {
      return shift.id is string
             && shift.staffId is string
             && shift.dayIndex is int
             && shift.dayIndex >= 0 && shift.dayIndex <= 6
             && shift.startTime is number
             && shift.endTime is number
             && shift.startTime >= 0 && shift.endTime <= 24
             && shift.endTime > shift.startTime;
    }

    // Rules have no loops. Validating a sample of the array is a deliberate
    // trade-off: it catches a malformed client without making the rule
    // unreadable. The shape is enforced end-to-end by the app's types.
    function isValidWeeklyData(data) {
      return data.shifts is list
             && data.shifts.size() <= 100
             && data.updatedAt is string
             && (data.shifts.size() == 0 || isValidShift(data.shifts[0]))
             && (data.shifts.size() <= 1 || isValidShift(data.shifts[data.shifts.size() - 1]));
    }

    function isValidLog(data) {
      return data.userId is string
             && data.userName is string
             && data.action is string
             && data.details is string
             && data.timestamp is string
             && data.userId == request.auth.uid;   // cannot log as someone else
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /weeks/{weekId} {
      allow read: if isTeamMember();
      allow write: if isAdmin() && isValidWeeklyData(request.resource.data);
    }

    match /settings/staff {
      allow read: if isTeamMember();
      allow write: if isAdmin();
    }

    match /settings/global {
      allow read: if isTeamMember();
      allow write: if isAdmin();
    }

    match /logs/{logId} {
      // Readable by the team: the journal is a shared record, and restricting
      // reads to admins would make subscribing crash for everyone else.
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidLog(request.resource.data);
      // The journal is an audit trail. Nobody edits it from the app; pruning
      // old entries is done with the admin SDK, which bypasses these rules.
      allow update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
